{
  "name": "pixclean",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PixelClean Studio — nettoyage de mixels et uniformisation de palette pixel art, propulsé par dot-stash.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./engine": {
      "types": "./dist-lib/engine/index.d.ts",
      "import": "./dist-lib/engine.js"
    },
    "./style.css": "./dist-lib/pixclean.css"
  },
  "files": [
    "dist-lib/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "dot-stash": "https://github.com/jezoock/dot-stash/releases/download/v0.2.0/dot-stash-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "sass": "^1.107.1",
    "typescript": "~5.8.3",
    "vite": "^6.2.0"
  }
}
